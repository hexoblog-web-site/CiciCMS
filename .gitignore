# ---- 本地配置（含数据库账号密码，绝不入库）----
/config.php
/includes/config.php

# ---- 运行时数据 ----
/content/data/cache/
/content/data/logs/
/content/data/backup/
/content/data/tmp/
/content/data/*.json
/content/data/*.lock

# ---- 上传附件 ----
/content/uploads/**
!/content/uploads/.htaccess

# ---- 静态生成产物（每次发布都会重写）----
/index.html
/tags.html
/archive.html
/links.html
/404.html
/sitemap.xml
/rss.xml
/page/
/tag/
/uncategorized/

# ---- 依赖与构建产物 ----
/docs/node_modules/
/docs/.vitepress/dist/
/docs/.vitepress/cache/
node_modules/

# ---- 编辑器与系统文件 ----
.DS_Store
Thumbs.db
*.log
*.tmp

# ---- 设计预览稿（本地看样式用，不进发布包）----
/_preview/
/_preview_*.html
/docs/_preview/

# ---- 本地测试后门与临时入口（绝不入库）----
/_autologin.php
/admin/index-legacy.php
/admin/assets/zblog/image/admin/logo_zblog.svg.bak

# ---- 本地生成的静态页（含 localhost 链接，不入库）----
/about.html
/default/
