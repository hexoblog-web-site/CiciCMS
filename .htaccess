# CiciCMS 目录保护与默认首页
# 整站是真实静态文件：请求直接命中磁盘上的 .html，不使用任何伪静态 / rewrite 规则。
DirectoryIndex index.html index.php

# 404 交给生成好的静态页（不经过 PHP，也不做任何跳转）
ErrorDocument 404 /404.html

# 关闭目录列表（部分虚拟主机不允许 Options，用 IfModule 包裹避免 500）
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

AddDefaultCharset UTF-8

# 发布签名工具只在命令行用，Web 访问一律拒绝
# （用 RewriteRule - [F] 而不是 RedirectMatch：站点装在子目录时路径也对）
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tools/ - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(update-manifest\.json)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(update-manifest\.json)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 保护配置文件与日志、备份文件
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(log|lock|sql|bak|ini)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(log|lock|sql|bak|ini)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 静态资源缓存
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
