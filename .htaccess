# HtmlCms 目录保护与默认首页
# 静态 HTML 优先生效，未生成静态页时回落到 index.php（动态预览）
DirectoryIndex index.html index.php

# 关闭目录列表（部分虚拟主机不允许 Options，用 IfModule 包裹避免 500）
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 老地址 301 与未生成页面的兜底
# 静态页已存在就直接由服务器发出（!-f 判断），只有"文件不存在"的请求才交给 index.php，
# 由 PHP 决定：老地址 → 301 到新地址；确实没有 → 404 页面。
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 改版前的文章地址 /post/<slug>.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^post/[A-Za-z0-9_-]+\.html$ index.php [L,QSA]

    # 改版前的分类地址 /cat/<目录>/index.html、/cat/<目录>/page/N/index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^cat/[A-Za-z0-9_-]+/(index\.html|page/[0-9]+/index\.html)?$ index.php [L,QSA]

    # 分类改过名之后的文章地址 /<旧目录>/<id>.html（按文章 ID 找到现地址）
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[A-Za-z0-9_-]+/[0-9]+\.html$ index.php [L,QSA]
</IfModule>

AddDefaultCharset UTF-8

# 保护配置文件与日志、备份文件
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(log|lock|sql|bak|ini)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(log|lock|sql|bak|ini)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 静态资源缓存
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
