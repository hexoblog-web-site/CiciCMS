# 禁止在上传目录执行任何脚本
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
